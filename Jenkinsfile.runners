// 러너 이미지 4개(코딩 문제 실행, spec #93 2절)를 buildx 로 amd64+arm64 굽고 GHCR 에 올린다 — scripts/build-runners.sh.
// 잡 이름 제안: sandcorp-promptlab-runners (Pipeline from SCM, Script Path = Jenkinsfile.runners, 브랜치 main, 손으로만 돌린다).
// oracle 에서는 굽지 않는다. 빌드 노드: home(라벨 built-in) — buildx·QEMU(binfmt arm64)가 있어야 한다. 자격: ghcr-push-token(문자열).
// 끝나면 「digest」 줄(아카이브 runner-digests.txt)을 crates/shared/src/coding/mod.rs 의 RUNNER_IMAGES 에 적는 PR 을 낸다.
// 첫 push 뒤 GHCR 패키지 4개(promptlab-runner-<언어>)를 공개로 바꾼다(응시자가 로그인 없이 받는다).
pipeline {
  agent { label 'built-in' }
  options { timeout(time: 90, unit: 'MINUTES'); timestamps(); disableConcurrentBuilds(); buildDiscarder(logRotator(numToKeepStr: '10', artifactNumToKeepStr: '10')) }
  parameters {
    string(name: 'LANGS', defaultValue: '', description: '굽을 언어(공백 구분: python javascript java cpp). 비면 넷 다')
  }
  stages {
    stage('러너 이미지') {
      steps {
        withCredentials([string(credentialsId: 'ghcr-push-token', variable: 'GHCR_TOKEN')]) {
          sh 'DIGEST_FILE=runner-digests.txt bash scripts/build-runners.sh ${LANGS}'
        }
      }
    }
  }
  post {
    success { archiveArtifacts artifacts: 'runner-digests.txt', fingerprint: true }
  }
}
